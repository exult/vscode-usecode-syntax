{
    "name": "usecode-syntax",
    "displayName": "Exult Usecode Syntax",
    "description": "Syntax highlighting and formatting for Exult's UseCode C (UCC), with highlighting for UseCode eXTracted and UseCode Assembly files.",
    "version": "0.1.10",
    "publisher": "Exult",
    "license": "GPL-2.0-or-later",
    "icon": "images/icon.png",
    "keywords": [
        "usecode",
        "exult",
        "ucc",
        "syntax",
        "language"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/exult/vscode-usecode-syntax"
    },
    "bugs": {
        "url": "https://github.com/exult/vscode-usecode-syntax/issues"
    },
    "homepage": "https://exult.info",
    "engines": {
        "vscode": "^1.60.0"
    },
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:usecode"
    ],
    "scripts": {
        "compile": "tsc -p .",
        "test": "npm run compile && node --test tests/*.test.cjs",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package",
        "package:list": "vsce ls"
    },
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "contributes": {
        "configuration": {
            "title": "Usecode",
            "properties": {
                "usecode.format.maxLineLength": {
                    "type": "integer",
                    "default": 100,
                    "minimum": 40,
                    "scope": "resource",
                    "description": "Preferred line width when formatting Usecode. Atomic strings, comments, and function identity declarations can exceed this width."
                }
            }
        },
        "languages": [
            {
                "id": "usecode",
                "aliases": [
                    "Usecode C",
                    "usecode C",
                    "UseCode C",
                    "UCC",
                    "ucc"
                ],
                "extensions": [
                    ".uccpp",
                    ".ucpp",
                    ".ucc",
                    ".uc",
                    ".ucxt",
                    ".uchh",
                    ".uch",
                    ".uhh",
                    ".uh"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "usecode-asm",
                "aliases": [
                    "Usecode Assembly",
                    "UseCode Assembly",
                    "usecode-asm",
                    "uca"
                ],
                "extensions": [
                    ".uca"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "usecode",
                "scopeName": "source.usecode",
                "path": "./syntaxes/usecode.tmLanguage.json"
            },
            {
                "language": "usecode-asm",
                "scopeName": "source.usecode-asm",
                "path": "./syntaxes/usecode-asm.tmLanguage.json"
            }
        ]
    },
    "devDependencies": {
        "@types/vscode": "1.60.0",
        "@vscode/vsce": "4.0.0",
        "typescript": "7.0.2",
        "vscode-oniguruma": "2.0.1",
        "vscode-textmate": "9.3.2"
    }
}
