            "end": "\\}",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.block.begin.bracket.curly.usecode"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.block.end.bracket.curly.usecode"
                }
