                    "include": "#conversation-code"
                }
            ]
        },
        "script-context": {
            "name": "meta.script.usecode",
            "begin": "\\bscript\\b",
            "beginCaptures": {
                "0": {
                    "name": "keyword.function-like.usecode"
                }
            },
            "end": ";|(?<=\\})",
            "endCaptures": {
                "0": {
                    "name": "keyword.operator.usecode"
                }
            },
            "patterns": [
                {
                    "include": "#script-code"
                }
            ],
            "$comment": "Script mode starts immediately after script, including the receiver and delay. Balanced groups shield command terminators."
        },
        "append-context": {
            "name": "meta.append.usecode",
            "begin": "<<",
            "beginCaptures": {
                "0": {
                    "name": "keyword.operator.usecode"
                }
            },
            "end": "(?=;)|(?<=\\})",
            "patterns": [
                {
                    "include": "#script-block"
                },
                {
                    "include": "#contexts"
                },
                {
                    "include": "#normal-parens"
                },
                {
                    "include": "#normal-brackets"
                },
                {
                    "include": "#common-code"
                }
            ]
        },
        "conversation-context": {
            "name": "meta.conversation.usecode",
            "begin": "\\bconverse\\b",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.flow.usecode"
                }
            },
            "end": ";|(?<=\\})",
            "endCaptures": {
                "0": {
                    "name": "keyword.operator.usecode"
                }
            },
            "patterns": [
                {
                    "include": "#conversation-block"
                },
                {
                    "include": "#contexts"
                },
                {
                    "include": "#normal-parens"
                },
                {
                    "include": "#normal-brackets"
                },
                {
                    "include": "#common-code"
                }
            ]
        },
        "conversation-keywords": {
            "patterns": [
                {
                    "name": "keyword.control.flow.usecode",
                    "match": "\\bfallthrough\\b"
                }
            ]
        },
        "conversation-loop": {
            "name": "meta.loop.usecode",
            "begin": "\\b(?:while|for|do|forever|breakable|switch)\\b",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.flow.usecode"
                }
            },
            "end": ";|(?<=\\})",
            "endCaptures": {
                "0": {
                    "name": "keyword.operator.usecode"
                }
            },
            "patterns": [
                {
                    "include": "#normal-code"
                }
            ],
            "$comment": "Loop and switch bodies temporarily replace the conversation lexer state. Compound unbraced bodies are approximate; braces give reliable boundaries."
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.usecode",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.usecode",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.usecode",
                    "begin": "\"",
                    "end": "\"\\*?",
                    "patterns": [
                        {
                            "name": "constant.character.escape.usecode",
                            "match": "\\\\(?:n|t|r|\\\"|'|\\\\)"
                        },
                        {
                            "name": "constant.character.rune-escape.usecode",
                            "match": "\\\\\\{(?:dot|ea|ee|ng|st|th)\\}"
                        },
                        {
                            "name": "constant.character.escaped-other.usecode",
                            "match": "\\\\."
                        },
                        {
                            "match": "[^\\\\\"]+"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.usecode",
                    "match": "\\b0[xX][0-9A-Fa-f]+\\b"
                },
                {
                    "name": "constant.numeric.integer.usecode",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "invalid.illegal.numeric.usecode",
                    "match": "\\b[0-9][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*(?:include|game)(?=\\s|$)",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        },
                        {
                            "name": "string.quoted.double.usecode",
                            "match": "\"[^\"]*\""
                        }
                    ]
                },
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*line(?=\\s|$)",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        },
                        {
                            "name": "constant.numeric.integer.usecode",
                            "match": "[0-9]+"
                        },
                        {
                            "name": "string.quoted.double.usecode",
                            "match": "\"[^\"]*\""
                        }
                    ]
                },
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*(?=[0-9])",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        },
                        {
                            "name": "constant.numeric.integer.usecode",
                            "match": "[0-9]+"
                        },
                        {
                            "name": "string.quoted.double.usecode",
                            "match": "\"[^\"]*\""
                        }
                    ]
                },
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*autonumber(?=\\s|$)",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        },
                        {
                            "name": "constant.numeric.hex.usecode",
                            "match": "\\b0[xX][0-9A-Fa-f]+\\b"
                        },
                        {
                            "name": "constant.numeric.octal.usecode",
                            "match": "\\b0[0-7]+\\b"
                        },
                        {
                            "name": "invalid.illegal.numeric.usecode",
                            "match": "\\b0[0-9]+\\b"
                        },
                        {
                            "include": "#numbers"
                        }
                    ]
                },
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*strictbraces(?=\\s|$)",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        },
                        {
                            "name": "constant.language.boolean.usecode",
                            "match": "\"(?:true|false)\""
                        },
                        {
                            "name": "string.quoted.double.usecode",
                            "match": "\"[^\"]*\""
                        }
                    ]
                },
                {
                    "name": "meta.directive.usecode",
                    "begin": "#\\s*[^\\s]*",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.directive.usecode"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "comment.line.double-slash.usecode",
                            "match": "//.*$"
                        },
                        {
                            "name": "comment.block.usecode",
                            "match": "/\\*.*?(?:\\*/|$)"
                        }
                    ],
                    "contentName": "string.untyped.directive-args.usecode"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "(\\.)(original)\\b",
                    "captures": {
                        "1": { "name": "keyword.operator.usecode" },
                        "2": { "name": "keyword.function-like.usecode" }
                    }
                },
                {
                    "name": "keyword.operator.usecode",
                    "match": "\\b(?:new|delete)\\b"
                },
                {
                    "name": "variable.language.this.usecode",
                    "match": "\\bthis\\b"
                },
                {
                    "name": "variable.language.item.usecode",
                    "match": "\\bitem\\b"
                },
                {
                    "name": "keyword.other.event.usecode",
                    "match": "\\bevent\\b"
                },
                {
                    "name": "keyword.other.user_choice.usecode",
                    "match": "\\buser_choice\\b"
                },
                {
                    "name": "keyword.control.flow.usecode",
                    "match": "\\b(?:if|else|return|do|while|for|nobreak|switch|converse|case|always|default|try|catch|throw|abort|forever|breakable|break|continue)\\b"
                },
                {
                    "name": "storage.type.usecode",
                    "match": "\\b(?:class|struct)\\b(?=\\s*<)"
                },
                {
                    "name": "storage.type.declaration.usecode",
                    "match": "\\b(?:class|struct|enum|nested)\\b"
                },
                {
                    "name": "keyword.declaration.variable.usecode",
                    "match": "\\b(?:var|alias|extern|declare)\\b"
                },
                {
                    "name": "storage.type.usecode",
                    "match": "\\b(?:void|int|char|byte|long|string|const)\\b"
                },
                {
                    "name": "constant.language.value.usecode",
                    "match": "\\b(?:true|false|gflags)\\b"
                },
                {
                    "name": "keyword.function-like.usecode",
                    "match": "\\bsay\\b"
                },
                {
                    "name": "keyword.function-like.usecode",
                    "match": "\\b(?:message|response|show|hide|remove|add|script|run_script|assume_script)\\b"
                },
                {
                    "name": "keyword.other.usecode",
                    "match": "\\b(?:after|ticks|minutes|hours|with|to|static|endconv)\\b"
                }
            ]
        },
        "goto-type": {
            "patterns": [
                {
                    "name": "keyword.other.goto-type.usecode",
                    "match": "\\b(?:goto|attend)\\b"
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "begin": "\\b(?:goto|attend)\\b",
                    "beginCaptures": {
                        "0": { "name": "keyword.other.goto-type.usecode" }
                    },
                    "end": "\\b[A-Za-z_][A-Za-z0-9_]*\\b|(?=[;{}:])",
                    "endCaptures": {
                        "0": { "name": "entity.name.label.usecode" }
                    },
                    "patterns": [{ "include": "#comments" }]
                },
                {
                    "begin": "\\b(?:break|continue)\\b",
                    "beginCaptures": {
                        "0": { "name": "keyword.control.flow.usecode" }
                    },
                    "end": "\\b[A-Za-z_][A-Za-z0-9_]*\\b|(?=[;{}:])",
                    "endCaptures": {
                        "0": { "name": "entity.name.label.usecode" }
                    },
                    "patterns": [{ "include": "#comments" }]
                },
                {
                    "match": "(?:^|(?<=[{};:)]))\\s*((?!(?:always|default|converse|case)\\b)[A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
                    "captures": {
                        "1": { "name": "entity.name.label.usecode" },
                        "2": { "name": "keyword.operator.usecode" }
                    }
                }
            ]
        },
        "script-commands": {
            "patterns": [
                {
                    "name": "keyword.script.usecode",
                    "match": "\\b(?:say|remove|continue|raw|nop|nop2|nohalt|next|finish|resurrect|reset|repeat|wait|rise|descent|frame|hatch|setegg|previous|cycle|step|music|call|speech|sfx|face|weather|hit|attack|actor)\\b"
                },
                {
                    "name": "constant.language.value.usecode",
                    "match": "\\b(?:near|far|north|south|east|west|nw|ne|sw|se|standing|step_right|step_left|ready|raise_1h|reach_1h|strike_1h|raise_2h|reach_2h|strike_2h|sitting|bowing|kneeling|sleeping|cast_up|cast_out|cached_in|party_near|avatar_near|avatar_far|avatar_footpad|party_footpad|something_on|external_criteria|normal_damage|fire_damage|magic_damage|lightning_damage|poison_damage|starvation_damage|freezing_damage|ethereal_damage|sonic_damage)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.usecode",
                    "match": "\\b(?:void|int|char|byte|long|string)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "\\b(object|id|shape)(#)(?=\\s*\\()",
                    "captures": {
                        "1": { "name": "keyword.operator.usecode" },
                        "2": { "name": "punctuation.section.parens" }
                    }
                },
                {
                    "name": "keyword.operator.usecode",
                    "match": "(?:<<|\\+=|-=|\\*=|/=|%=|&=|&&|\\|\\||==|!=|<=|>=|->|::)"
                },
                {
                    "name": "keyword.operator.usecode",
                    "match": "(?:!|&|\\-|\\+|\\*|/|%|=|\\.|,|;|:|@|<|>)"
                },
                {
                    "name": "punctuation.section.parens.begin.bracket.round.usecode",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.bracket.round.usecode",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.block.begin.bracket.square.usecode",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.block.end.bracket.square.usecode",
                    "match": "\\]"
                },
                {
                    "name": "punctuation.section.block.begin.bracket.curly.usecode",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.block.end.bracket.curly.usecode",
                    "match": "\\}"
                },
                {
                    "name": "keyword.operator.usecode",
                    "match": "\\b(?:in)\\b"
                }
            ]
        },
        "intrinsics": {
            "patterns": [
                {
                    "name": "entity.name.function.intrinsic.usecode",
                    "match": "\\b(?:UI_)?(?:get_random|execute_usecode_array|delayed_execute_usecode_array|show_npc_face|remove_npc_face|show_npc_face0|show_npc_face1|remove_npc_face0|remove_npc_face1|add_answer|remove_answer|push_answers|pop_answers|clear_answers|select_from_menu|select_from_menu2|input_numeric_value|set_item_shape|find_nearest|play_sound_effect|die_roll)\\b"
                },
                {
                    "name": "entity.name.function.intrinsic.usecode",
                    "match": "\\b(?:UI_)?(?:get_item_shape|get_item_weight|get_item_frame|set_item_frame|get_item_quality|set_item_quality|get_item_quantity|set_item_quantity|get_object_position|get_distance|find_direction|get_npc_object|get_schedule_type|set_schedule_type|add_to_party|remove_from_party|get_npc_prop|set_npc_prop|get_avatar_ref|get_party_list|get_party_list2)\\b"
                },
                {
                    "name": "entity.name.function.intrinsic.usecode",
                    "match": "\\b(?:UI_)?(?:create_new_object|create_new_object2|set_last_created|update_last_created|get_npc_name|count_objects|find_object|get_cont_items|remove_party_items|add_party_items|add_cont_items|remove_cont_items|get_music_track|play_music)\\b"
                },
                {
                    "name": "entity.name.function.intrinsic.usecode",
                    "match": "\\b(?:UI_)?(?:npc_nearby|npc_nearby2|find_nearby_avatar|is_npc|display_runes|click_on_item|error_message|find_nearby|give_last_created|is_dead|game_hour|game_minute|get_npc_number|get_npc_id|set_npc_id|part_of_day|get_alignment|set_alignment)\\b"
                },
